{
	"$schema": "https://biomejs.dev/schemas/2.3.5/schema.json",
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"noNonNullAssertion": "off",
				"useConst": "error",
				"useNodejsImportProtocol": "off"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noControlCharactersInRegex": "off",
				"noEmptyInterface": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"indentStyle": "tab",
		"indentWidth": 3,
		"lineWidth": 120
	},
	"files": {
		"includes": [
			"packages/*/src/**/*.ts",
			"packages/*/test/**/*.ts",
			"packages/coding-agent/examples/**/*.ts",
			"packages/openpi-desktop/web/**/*.ts",
			"packages/openpi-desktop/web/**/*.tsx",
			"packages/openpi-desktop/test/**/*.{ts,mjs}",
			"!**/node_modules/**/*",
			"!**/test-sessions.ts",
			"!**/models.generated.ts",
			"!**/*.models.ts",
			"!packages/mom/data/**/*",
			"!!**/node_modules",
			"!**/.claude/**/*",
			"!!**/.claude"
		]
	},
	"overrides": [
		{
			"includes": ["packages/openpi-desktop/web/**/*.tsx", "packages/openpi-desktop/web/**/*.ts"],
			"linter": {
				"rules": {
					"a11y": {
						"recommended": false
					},
					"correctness": {
						"useExhaustiveDependencies": "off",
						"noUnusedVariables": "off",
						"noUnusedImports": "off"
					},
					"suspicious": {
						"noArrayIndexKey": "off",
						"noExplicitAny": "off"
					}
				}
			}
		}
	]
}
