{
	"name": "@earendil-works/openpi-security",
	"version": "0.80.8",
	"description": "Security gate and audit for OpenPI personal agent",
	"type": "module",
	"keywords": [
		"pi-package",
		"openpi",
		"security"
	],
	"license": "MIT",
	"pi": {
		"extensions": [
			"./src/index.ts"
		],
		"permissions": {
			"network": false,
			"fs": "project",
			"shell": "gate",
			"env": false
		}
	},
	"private": true,
	"files": [
		"src",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"test": "vitest --run"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "^0.80.7"
	},
	"devDependencies": {
		"vitest": "4.1.9"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
