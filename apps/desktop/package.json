{
  "name": "@openpi/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenPI desktop app: Electron shell over the openpi daemon",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --port 5179\" \"npm:dev:electron\"",
    "dev:electron": "wait-on tcp:5179 && npm run build:electron && electron .",
    "build:electron": "node scripts/build-electron.mjs",
    "build:web": "vite build",
    "build": "npm run build:electron && npm run build:web",
    "start": "npm run build && OPENPI_DESKTOP_PROD=1 electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest --run",
    "build:runtime": "node scripts/build-runtime.mjs",
    "pack:dir": "npm run build && npm run build:runtime && electron-builder --dir",
    "pack:mac": "npm run build && npm run build:runtime && electron-builder --mac",
    "install:local": "npm run pack:mac && node scripts/install-local.mjs"
  },
  "dependencies": {
    "@openpi/shared": "*",
    "@radix-ui/react-popover": "1.1.19",
    "@radix-ui/react-select": "2.3.3",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "mammoth": "1.12.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "9.2.1",
    "electron": "38.2.2",
    "electron-builder": "26.0.12",
    "esbuild": "0.25.10",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "7.1.9",
    "vitest": "3.2.4",
    "wait-on": "9.0.1"
  }
}
