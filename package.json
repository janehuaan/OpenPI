{
  "name": "openpi-next",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "yarn --cwd apps/desktop build",
    "typecheck": "yarn --cwd apps/desktop typecheck",
    "test": "cargo test --workspace && yarn --cwd apps/desktop test",
    "check": "yarn typecheck && yarn test"
  },
  "devDependencies": {
    "@types/node": "24.7.0",
    "typescript": "5.9.3"
  }
}
