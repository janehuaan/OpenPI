{
  "name": "openpi-next",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "yarn --cwd apps/desktop build",
    "homepage:dev": "yarn --cwd apps/homepage dev",
    "homepage:build": "yarn --cwd apps/homepage build",
    "homepage:preview": "yarn --cwd apps/homepage preview",
    "typecheck": "yarn --cwd apps/desktop typecheck",
    "test": "cargo test --workspace && yarn --cwd apps/desktop test",
    "cost": "python3 scripts/cost-baseline.py",
    "check:targets": "bash scripts/check-targets.sh",
    "check": "yarn typecheck && yarn test"
  },
  "devDependencies": {
    "@types/node": "24.7.0",
    "typescript": "5.9.3"
  }
}
