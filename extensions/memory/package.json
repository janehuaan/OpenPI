{
  "name": "@openpi/extension-memory",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "File-based long-term memory for openpi (hashed n-gram vectors + BM25, fully local)",
  "keywords": ["pi-package", "openpi", "memory"],
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "typebox": "1.3.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-agent-core": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4"
  },
  "devDependencies": {
    "vitest": "3.2.4"
  },
  "scripts": {
    "test": "vitest --run"
  }
}
